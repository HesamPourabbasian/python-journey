generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Level {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  roman       String
  badge       String
  description String   @db.Text
  tone        String
  accentColor String   @default("#b28a47")
  order       Int      @unique
  modules     Module[]
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Module {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  order       Int
  levelSlug   String
  level       Level    @relation(fields: [levelSlug], references: [slug], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([levelSlug])
}

model Lesson {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  levelSlug   String
  level       Level    @relation(fields: [levelSlug], references: [slug], onDelete: Cascade)
  moduleSlug  String
  module      Module   @relation(fields: [moduleSlug], references: [slug], onDelete: Cascade)
  order       Int
  intro       String   @db.Text
  content     String   @db.Text
  code        String   @db.Text
  topics      String[]
  filePath    String
  isProject   Boolean  @default(false)
  readTime    Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([levelSlug])
  @@index([moduleSlug])
}
